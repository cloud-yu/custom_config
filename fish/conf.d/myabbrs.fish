# git abbr
abbr -a --position command -- gst git status
abbr -a --position command -- glog git log
abbr -a --position command -- gdif git diff
abbr -a --position command -- gsw git switch
abbr -a --position command -- gbr git branch

# grep abbr to enable color
#abbr -a --position command -- grep grep --color=auto

# ip route alias for ipv6
abbr -a --position command -- ip6 ip -6

# tmux abbr
abbr -a --position command -- ta tmux attach
